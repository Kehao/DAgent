# ============================================================
# DAgent 环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env
# ============================================================

# LLM API Key（阿里云百炼 DashScope，通义千问）
# 获取：https://bailian.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=sk-你的key

# 模型名（可选，默认 qwen-plus）
LLM_MODEL=qwen-plus

# MCP Server 地址（可选，默认本地 9100）
MCP_SERVER_URL=http://localhost:9100
