# ============================================================
# DAgent MCP Server —— systemd 单元模板（阿里云 ECS 实测可用）
# ============================================================
# 安装：见同目录 install.sh（拷贝到 /etc/systemd/system + daemon-reload + enable）
#
# 说明：
#   · WorkingDirectory 必须是项目根目录 —— src/config.py 的 load_dotenv()
#     靠它读取 .env（进程 cwd 不对会读不到 DASHSCOPE_API_KEY）
#   · EnvironmentFile 指向 .env，等价于把配置注入进程环境
#   · Restart=always 保证进程崩溃后自动拉起
#   · 端口由 .env 控制（MCP_SERVER_URL 默认 http://localhost:9100）
# ============================================================

[Unit]
Description=DAgent MCP Server (:9100)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/dagent
EnvironmentFile=/opt/dagent/.env
ExecStart=/opt/dagent/.venv/bin/python -m src.mcp_server.server_main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
